# Copy to android/key.properties (git-ignored) and fill in. Never commit the
# real file or the keystore. storeFile is resolved relative to android/app/.
#
# Create the upload keystore once (keep it AND the passwords backed up):
#   keytool -genkey -v -keystore ~/keys/domovoi-upload.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/home/you/keys/domovoi-upload.jks
